# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 私人学习笔记，不发布
.notes/

# 私人材料，永不进公开仓（2026-11-15）
# 这个仓库是作品库、公开可见；真实数据与私人材料一律留在本机/知识库
.notes/
private/
*.local.json
*.private.md
*.private.json
# 真实训练/健康数据导出（体积大且含个人信息）
*.fit
*.gpx
